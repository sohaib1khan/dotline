# Host port (change if already used on your server)
DOTLINE_PORT=47391

# Public URL for email links. Leave as localhost until Nginx Proxy Manager (or
# similar) serves HTTPS — then set https://your.domain and recreate the app.
PUBLIC_BASE_URL=http://localhost:47391

# Secure cookies: leave false for http://LAN-IP access. Set true only after HTTPS.
COOKIE_SECURE=false

# Database
POSTGRES_DB=dotline
POSTGRES_USER=dotline
POSTGRES_PASSWORD=change_me

# Security — generate real values, never commit them (./scripts/bootstrap.sh does this)
SECRET_KEY=change_me_long_random_string
APP_ENCRYPTION_KEY=change_me_fernet_key

# Writable overlay for imported course YAML (Docker default shown)
CONTENT_DATA_DIR=/app/data/content

# Environment
APP_ENV=production
